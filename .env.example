# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production only: share the session cookie with subdomain apps.
# Set to .eatableadventures.com on the production deployment.
# Leave empty for local dev and *.vercel.app previews.
AUTH_COOKIE_DOMAIN=
