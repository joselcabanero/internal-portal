# Which portal this deploy is: "tools" (default, tools.eatableadventures.com: platform apps + the other tools)
# or "ecosystem" (ecosystem.eatableadventures.com: Jarvis 2, Scout, DataLab and Ontology Studio only).
PORTAL_EDITION=
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production only: share the session cookie with subdomain apps.
# Set to .eatableadventures.com on the production deployment.
# Leave empty for local dev and *.vercel.app previews.
AUTH_COOKIE_DOMAIN=

# --- Platform app zones (lib/apps.ts) ---
# Upstream origin of each Jarvis 2 app. Each app is its own deploy with
# basePath set to its zone path. Unset = shown as "coming soon", not routed.
# Read at BUILD time (rewrites): change on Vercel => redeploy.
ZONE_JARVIS_URL=
ZONE_SCOUT_URL=
# DataLab (formerly Data Navigator), served at /datalab; /navigator redirects there.
ZONE_NAVIGATOR_URL=
ZONE_ONTOLOGY_STUDIO_URL=
ZONE_PROGRAMS_URL=
ZONE_REVENUE_URL=

# --- Platform API token (/api/platform/token) ---
# Dedicated secret for the 5-minute Platform API token. NOT the portal's
# AUTH_SECRET. The Platform API must be configured with the same value as its
# AUTH_SECRET. Generate with: npx auth secret
PLATFORM_TOKEN_SECRET=
# Salt for that token; must equal the API's AUTH_SESSION_COOKIE.
# Leave empty to use the API's default (__Secure-authjs.session-token).
PLATFORM_TOKEN_SALT=

# --- Platform API, called by the portal itself (ecosystem edition: workspace selector, home card totals) ---
# Origin of eatable-platform/apps/api, e.g. http://127.0.0.1:8080. Uses PLATFORM_TOKEN_SECRET above.
# Unset = the selector shows built-in market names only and the cards show no totals.
PLATFORM_API_URL=
